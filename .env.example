# =============================================================================
# Hintavahti - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values.
# =============================================================================

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
# Host port 5434 matches docker-compose.yml (avoids clashing with a local
# Postgres on 5432).
DATABASE_URL=postgresql://postgres:postgres@localhost:5434/hintavahti
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5434/hintavahti_test

# Set to true to log every SQL statement (noisy during scheduled checks).
DB_LOG_QUERIES=false

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
APP_URL=http://localhost:3000

# NODE_ENV is deliberately NOT set here. Vite loads this file before its own
# config runs, so a NODE_ENV line leaks into `vite build` and selects React's
# development JSX runtime — the built server then calls jsxDEV, which the
# production React build does not export, and every page 500s.
#
# vite.config.ts derives NODE_ENV from the command being run instead. Nothing
# in the app reads it. Set it in your process manager for the deployed server
# (see scripts/README.md), not here.

# -----------------------------------------------------------------------------
# Shared secret for external callers (Chrome extension + cron)
# -----------------------------------------------------------------------------
# Used by POST /api/ingest and POST /api/cron/check. These endpoints are not
# protected by CSRF (external callers cannot send same-origin headers), so this
# secret is their only gate. Generate a strong random value:
#
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
#
INGEST_SECRET=change-me

# Origin allowed to call /api/ingest via CORS. For an unpacked MV3 extension
# this is chrome-extension://<your-extension-id>. Comma-separate to allow more
# than one (e.g. an unpacked dev build and a packed one).
#
# Only these origins get Access-Control-Allow-Origin, and it is echoed back
# rather than wildcarded — these endpoints are secret-gated and a wildcard
# would let any page on the internet probe them.
EXTENSION_ORIGIN=chrome-extension://replace-with-extension-id
