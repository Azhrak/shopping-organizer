{
	"manifest_version": 3,
	"name": "Hintavahti",
	"version": "0.1.0",
	"description": "Save every open product tab to your Hintavahti price watch.",
	"permissions": ["tabs", "storage", "scripting"],
	"host_permissions": ["http://localhost/*", "https://*/*"],
	"action": {
		"default_title": "Hintavahti",
		"default_popup": "popup.html"
	},
	"options_ui": {
		"page": "options.html",
		"open_in_tab": true
	},
	"background": {
		"service_worker": "service-worker.js",
		"type": "module"
	},
	"web_accessible_resources": [
		{
			"resources": ["shared.generated.js", "picker.js", "picker-entry.js"],
			"matches": ["http://*/*", "https://*/*"]
		}
	]
}
